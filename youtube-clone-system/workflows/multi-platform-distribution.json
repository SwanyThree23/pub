{
  "name": "Multi-Platform Content Distribution",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "distribute-content",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook - Distribute Content",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "distribute-content"
    },
    {
      "parameters": {
        "functionCode": "// Parse distribution request\nconst contentId = items[0].json.content_id;\nconst platforms = items[0].json.platforms || [];\n\nif (!contentId || !platforms.length) {\n  throw new Error('Content ID and platforms required');\n}\n\nreturn [{\n  json: {\n    content_id: contentId,\n    platforms: platforms,\n    timestamp: new Date().toISOString(),\n    status: 'pending_retrieval'\n  }\n}];"
      },
      "name": "Parse Request",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "findOne",
        "collection": "generated_content",
        "query": "={\"_id\": \"{{$json.content_id}}\"}",
        "options": {}
      },
      "name": "Fetch Content from Database",
      "type": "n8n-nodes-base.mongodb",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.final_content}}",
              "operation": "notEmpty"
            },
            {
              "value1": "={{$json.attribution_added}}",
              "operation": "equal",
              "value2": "true"
            }
          ]
        }
      },
      "name": "Verify Content Ready",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "functionCode": "// Split content for different platforms\nconst content = items[0].json.final_content;\nconst platforms = items[0].json.platforms;\n\nconst AttributionEngine = {\n  // Platform-specific attribution formatters\n  formatForTwitter(content, sources) {\n    // Truncate for Twitter's character limit\n    const mainContent = content.substring(0, 2000);\n    const thread = [];\n\n    // Main tweet(s)\n    const chunks = this.chunkText(mainContent, 280);\n    chunks.forEach(chunk => thread.push({ type: 'content', text: chunk }));\n\n    // Attribution tweets\n    thread.push({ type: 'attribution', text: '📚 Sources:' });\n    sources.slice(0, 3).forEach((src, i) => {\n      thread.push({\n        type: 'source',\n        text: `${i + 1}. ${src.title} by ${src.creator}\\n${src.url}`\n      });\n    });\n\n    return thread;\n  },\n\n  formatForLinkedIn(content, sources) {\n    let post = content;\n    post += '\\n\\n━━━━━━━━━━━━━━━━━━━━━━━━━━\\n';\n    post += '📚 Research Sources:\\n\\n';\n    sources.forEach((src, i) => {\n      post += `${i + 1}. ${src.title}\\n   By ${src.creator}\\n   ${src.url}\\n\\n`;\n    });\n    post += '#ContentAttribution #FairUse';\n    return post;\n  },\n\n  formatForBlog(content, sources) {\n    // Already formatted with HTML attribution\n    return content;\n  },\n\n  chunkText(text, maxLength) {\n    const words = text.split(' ');\n    const chunks = [];\n    let current = '';\n\n    words.forEach(word => {\n      if ((current + word).length > maxLength) {\n        chunks.push(current.trim());\n        current = word + ' ';\n      } else {\n        current += word + ' ';\n      }\n    });\n\n    if (current) chunks.push(current.trim());\n    return chunks;\n  }\n};\n\nconst formattedContent = {};\nconst sources = items[0].json.sources || [];\n\nplatforms.forEach(platform => {\n  switch (platform) {\n    case 'twitter':\n      formattedContent.twitter = AttributionEngine.formatForTwitter(content, sources);\n      break;\n    case 'linkedin':\n      formattedContent.linkedin = AttributionEngine.formatForLinkedIn(content, sources);\n      break;\n    case 'blog':\n      formattedContent.blog = AttributionEngine.formatForBlog(content, sources);\n      break;\n    case 'medium':\n      formattedContent.medium = content;  // Medium supports long-form\n      break;\n  }\n});\n\nreturn [{\n  json: {\n    ...items[0].json,\n    formatted_content: formattedContent,\n    status: 'formatted'\n  }\n}];"
      },
      "name": "Format for Platforms",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Split Platforms",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.platforms[$index]}}",
              "operation": "equal",
              "value2": "twitter"
            }
          ]
        }
      },
      "name": "Is Twitter?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twitter.com/2/tweets",
        "authentication": "oAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.TWITTER_BEARER_TOKEN}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{$json.formatted_content.twitter[0].text}}"
            }
          ]
        }
      },
      "name": "Post to Twitter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1650, 100]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.platforms[$index]}}",
              "operation": "equal",
              "value2": "linkedin"
            }
          ]
        }
      },
      "name": "Is LinkedIn?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/v2/ugcPosts",
        "authentication": "oAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.LINKEDIN_ACCESS_TOKEN}}"
