            },
            {
              "name": "specificContent",
              "value": "={\"com.linkedin.ugc.ShareContent\": {\"shareCommentary\": {\"text\": \"{{$json.formatted_content.linkedin}}\"}}}"
            }
          ]
        }
      },
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1650, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.platforms[$index]}}",
              "operation": "equal",
              "value2": "blog"
            }
          ]
        }
      },
      "name": "Is Blog?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1450, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BLOG_API_ENDPOINT}}/posts",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.BLOG_API_KEY}}"
