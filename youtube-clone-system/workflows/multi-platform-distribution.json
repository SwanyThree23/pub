            },
            {
              "name": "status",
              "value": "published"
            }
          ]
        }
      },
      "name": "Post to Blog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "functionCode": "// Merge all platform results\nconst results = items.map(item => ({\n  platform: item.json.platform || 'unknown',\n  post_id: item.json.id || item.json.data?.id,\n  post_url: item.json.url || item.json.data?.url,\n  posted_at: new Date().toISOString(),\n  status: 'published'\n}));\n\nreturn [{\n  json: {\n    content_id: items[0].json.content_id,\n    distribution_results: results,\n    total_platforms: results.length,\n    status: 'distributed'\n  }\n}];"
      },
      "name": "Merge Results",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1850, 200]
    },
    {
      "parameters": {
        "operation": "update",
        "collection": "generated_content",
        "updateKey": "_id",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "distribution_results",
              "fieldValue": "={{$json.distribution_results}}"
            },
            {
              "fieldId": "distributed_at",
              "fieldValue": "={{new Date().toISOString()}}"
            },
            {
              "fieldId": "status",
              "fieldValue": "distributed"
            }
          ]
        }
      },
      "name": "Update Database",
      "type": "n8n-nodes-base.mongodb",
      "typeVersion": 1,
      "position": [2050, 200]
    },
    {
      "parameters": {
        "functionCode": "// Track analytics\nconst analyticsRecords = items[0].json.distribution_results.map(result => ({\n  content_id: items[0].json.content_id,\n  platform: result.platform,\n  post_id: result.post_id,\n  post_url: result.post_url,\n  posted_at: result.posted_at,\n  initial_metrics: {\n    views: 0,\n    engagements: 0,\n    clicks: 0\n  },\n  last_checked: new Date().toISOString()\n}));\n\nreturn analyticsRecords.map(record => ({ json: record }));"
      },
      "name": "Create Analytics Records",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [2250, 200]
    },
    {
      "parameters": {
        "operation": "insert",
        "collection": "content_analytics",
        "options": {}
      },
      "name": "Store Analytics",
      "type": "n8n-nodes-base.mongodb",
      "typeVersion": 1,
      "position": [2450, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\\n  \"success\": true,\\n  \"content_id\": \"{{$json.content_id}}\",\\n  \"platforms_distributed\": {{$json.total_platforms}},\\n  \"results\": {{$json.distribution_results}},\\n  \"message\": \"Content successfully distributed to all platforms\"\\n}"
      },
      "name": "Response - Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2650, 200]
    },
