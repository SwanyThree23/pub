# N8N Configuration
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=your_n8n_api_key_here
N8N_WEBHOOK_URL=https://your-domain.com/webhook

# Claude AI Configuration
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4000
CLAUDE_TEMPERATURE=0.7

# OpenAI Configuration (Alternative)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# WhatsApp Configuration
WHATSAPP_API_URL=https://api.whatsapp.com/v1
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_API_URL=https://api.telegram.org

# Chat Platform Configuration
CHAT_API_URL=https://your-chat-api.com
CHAT_DB_PATH=./data/chat-history.db
CHAT_BATCH_WAIT_SECONDS=8
CHAT_MESSAGE_DELAY_MS=1000

# Google Services Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_SHEET_ID=your_google_sheet_id

# Weather Services
OPENWEATHER_API_KEY=your_openweather_api_key
AIRNOW_API_KEY=your_airnow_api_key
DEFAULT_CITY=San Francisco
DEFAULT_ZIP_CODE=94102

# Email Configuration
GMAIL_USER=your_email@gmail.com
DEFAULT_EMAIL_RECIPIENT=recipient@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true

# Database Configuration
DB_TYPE=sqlite
DB_PATH=./data/n8n.db
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_HOURS=24

# Data Storage
DATA_STORAGE_PATH=./data
UPLOAD_MAX_SIZE_MB=10
ALLOWED_FILE_TYPES=csv,json,txt,pdf

# Security Configuration
ENCRYPTION_KEY=your_256_bit_encryption_key_base64
ANONYMIZATION_SALT=your_random_salt_string
WEBHOOK_SECRET=your_webhook_secret_key
JWT_SECRET=your_jwt_secret_key

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Session Management
SESSION_SECRET=your_session_secret
SESSION_TIMEOUT_MINUTES=60
SESSION_COOKIE_SECURE=true

# Monitoring & Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE_MB=100
LOG_MAX_FILES=10

ENABLE_METRICS=true
METRICS_PORT=9090

SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=production

# Alerting
ALERT_EMAIL=alerts@example.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
PAGERDUTY_API_KEY=your_pagerduty_key

# MCP Server Configuration
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost
MCP_LOG_LEVEL=info

# API Integrations
TAVILY_API_KEY=your_tavily_search_api_key
SERPER_API_KEY=your_serper_api_key

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Feature Flags
ENABLE_BATCH_PROCESSING=true
ENABLE_MULTI_MESSAGE_RESPONSE=true
ENABLE_CONVERSATION_MEMORY=true
ENABLE_TOOL_ORCHESTRATION=true
ENABLE_DATA_ANALYTICS=true

# Performance Tuning
MAX_CONCURRENT_EXECUTIONS=10
WORKFLOW_TIMEOUT_SECONDS=300
TOOL_CALL_TIMEOUT_SECONDS=30
HTTP_REQUEST_TIMEOUT_MS=15000

# Compliance
GDPR_ENABLED=true
CCPA_ENABLED=true
DATA_RETENTION_DAYS=90
AUDIT_LOG_ENABLED=true

# Development Settings
NODE_ENV=production
DEBUG=false
ENABLE_CORS=true
CORS_ORIGIN=*

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# Queue Configuration
QUEUE_ENABLED=true
QUEUE_BACKEND=redis
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000

# Webhooks
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_MAX_REDIRECTS=3
WEBHOOK_VERIFY_SSL=true

# Business Configuration
COMPANY_NAME=Your Company Name
PRODUCT_SERVICE=Your Product/Service
SUPPORT_EMAIL=support@example.com
WEBSITE_URL=https://your-website.com

# Timezone
DEFAULT_TIMEZONE=America/Los_Angeles
USE_UTC=true

# Advanced Features
ENABLE_AI_STREAMING=false
ENABLE_VOICE_MESSAGES=false
ENABLE_IMAGE_PROCESSING=false
ENABLE_PDF_PARSING=false

# Development Tools
ENABLE_PLAYGROUND=false
ENABLE_API_DOCS=true
API_DOCS_PATH=/api/docs
